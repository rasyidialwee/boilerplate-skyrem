# Path-based packages cannot be unambiguously resolved when a package with the same
# name appears in multiple repositories. Exclude docs/tests from Packagist archives.
/.github export-ignore
/tests export-ignore
/test-output export-ignore
/bin/sandbox export-ignore
/.editorconfig export-ignore
/phpunit.xml export-ignore
/phpstan.neon export-ignore
/pint.json export-ignore
/testbench.yaml export-ignore
/.gitignore export-ignore
